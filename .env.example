# AgentFund ASP identity
NEXT_PUBLIC_SITE_URL=https://agentfund.vercel.app
NEXT_PUBLIC_AGENTFUND_RECEIVER_ADDRESS=0x0b95dF99653f9dA5cBdeaAbeb5B4110dE9D1073a
NEXT_PUBLIC_AGENTFUND_CHAIN_ID=196
NEXT_PUBLIC_AGENTFUND_CHAIN_NAME=X Layer Mainnet

# X Layer data
XLAYER_RPC_URL=https://rpc.xlayer.tech
DEXSCREENER_CHAIN_ID=xlayer
# Optional: comma-separated search terms used for market discovery.
AGENTFUND_DISCOVERY_QUERIES=xlayer,okx,okb
# Optional: force specific X Layer token contract addresses into the scan.
AGENTFUND_WATCHLIST=

# 0G / OpenAI-compatible LLM router
LLM_API_KEY=
LLM_BASE_URL=https://router-api.0g.ai/v1
LLM_MODEL=deepseek-v4-flash
LLM_TRUST_MODE=verified

# Payment enforcement
# production: requires official OKX x402 verification before service execution.
# disabled: local development only, never accepted in production.
AGENTFUND_PAYMENT_MODE=production
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://web3.okx.com
OKX_SYNC_SETTLE=true
X402_NETWORK=eip155:196
X402_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736
X402_ASSET_SYMBOL=USD₮0
X402_RECEIVER=0x0b95dF99653f9dA5cBdeaAbeb5B4110dE9D1073a

# Pricing, USD-denominated strings for OKX.AI listing/payment metadata.
PRICE_SCAN_XLAYER_MARKET=0.05
PRICE_SCORE_TOKEN_OPPORTUNITY=0.08
PRICE_GENERATE_TRADE_SIGNAL=0.10
PRICE_RISK_CHECK_TRADE=0.05
PRICE_SIMULATE_STRATEGY_NAV=0.06
PRICE_GENERATE_AGENT_UPDATE_POST=0.03
